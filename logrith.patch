+/* ==========================================================================
+   Logrith — page & tool styles
+   --------------------------------------------------------------------------
+   Rules that belong to one page or tool and are not part of the shared
+   design system (see style.css). Every page sets a unique class on <body>
+   (page-<name>) and its rules are scoped under it, so nothing leaks between
+   pages.
+
+   Contents
+     1. Shared tool patterns   — rules identical on three or more pages
+     2. Page & tool styles     — one block per page
+     3. Element-specific rules — former inline styles that target a single id
+     4. One-off utilities      — former inline styles shared by several elements
+   ========================================================================== */
+
+/* --------------------------------------------------------------------------
+   1. Shared tool patterns
+   -------------------------------------------------------------------------- */
+
+@keyframes spin { to{transform:rotate(360deg);} }
+
+@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.2} }
+
+@keyframes rot { to { transform: rotate(360deg); } }
+
+@keyframes fadeUp { from{opacity:0;transform:translateY(16px)} to{opacity:1;transform:none} }
+
+@keyframes fadeIn { from{opacity:0} to{opacity:1} }
+
+.post-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fit,minmax(280px,1fr));
+  gap: 18px;
+  max-width: 1100px;
+  margin: 0 auto;
+  padding: 0 20px 60px;
+}
+
+.post-card {
+  display: flex;
+  gap: 14px;
+  align-items: flex-start;
+  border: 1.5px solid var(--gray-200);
+  border-radius: var(--radius-lg);
+  padding: 20px;
+  text-decoration: none;
+  color: inherit;
+  background: var(--white);
+  transition: box-shadow .2s;
+}
+
+.post-card:hover {
+  box-shadow: var(--shadow-md);
+}
+
+.post-card .pc-icon {
+  width: 38px;
+  height: 38px;
+  border-radius: 10px;
+  background: var(--gray-100);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+}
+
+.post-card .pc-icon svg {
+  width: 18px;
+  height: 18px;
+  color: var(--primary);
+}
+
+.post-card h2 {
+  font-family: var(--font-display);
+  font-size: 1rem;
+  color: var(--gray-900);
